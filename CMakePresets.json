{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": ".base",
      "generator": "Ninja",
      "hidden": true,
      "cacheVariables": {
        "KRATOS_NONSQUARE_SUPPORT": "ON",
        "KRATOS_INDEX_TYPE": "std::size_t",
        "KRATOS_SIZE_TYPE": "std::size_t",
        "KRATOS_DOUBLE_TYPE": "double",
        "KRATOS_COMPLEX_TYPE": "std::complex<double>",
        "KRATOS_MATRIX_VECTOR_ADAPTER": "Ublas",
        "KRATOS_SD_REF_NUMBER": "2"
      }
    }
  ]
}